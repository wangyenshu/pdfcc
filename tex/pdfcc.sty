% pdfcc.sty - run programs compiled by pdfcc in LaTeX documents.
%
% Reads the files written by tools/pdf2sty.py: pdfcc-NAME.tex (layout),
% pdfcc-NAME.js (program) and pdfcc-runtime.js. See tex/README.md.
% pdfLaTeX, XeLaTeX or LuaLaTeX, TeX Live 2023 or newer. The programs run in
% Chromium's PDF viewer (PDFium) only.
%
% How it works. Each program instance owns one form field per terminal row,
% display row and keyboard (the parent fields). Every placement of a
% component adds widget annotations whose /Parent is such a field, so the
% same terminal can be shown several times (Beamer overlays), and a placement
% that is typeset but never shipped (tabularx trial runs, measuring boxes)
% leaves nothing behind. A page that shows a program gets a page-open action
% that runs: config, runtime, program, start; pdfcc_runtime.js makes every run
% after the first return at once. Which pages show which program: LuaLaTeX
% finds out while shipping the page; pdfLaTeX and XeLaTeX read it from the
% .aux file and, until it is there, put the program on every page.
\NeedsTeXFormat{LaTeX2e}[2023-06-01]
\ProvidesExplPackage{pdfcc}{2026-11-25}{1.0}
  {Programs compiled by pdfcc, in LaTeX documents}

% ------------------------------------------------------------- messages --
\msg_new:nnn { pdfcc } { engine }
  { pdfcc~needs~pdfLaTeX,~XeLaTeX~or~LuaLaTeX~with~PDF~output. }
\msg_new:nnn { pdfcc } { no-file }
  { File~'#1'~not~found.~Write~it~with~tools/pdf2sty.py. }
\msg_new:nnn { pdfcc } { bad-name }
  { Program~name~'#1'~must~be~lowercase~letters~and~digits. }
\msg_new:nnn { pdfcc } { duplicate }
  { A~program~named~'#1'~is~already~loaded.~Use~\pdfccload[name=...]{...}. }
\msg_new:nnn { pdfcc } { no-program }
  { No~program~'#1'~loaded.~Load~it~with~\pdfccload{#1}. }
\msg_new:nnn { pdfcc } { no-component }
  { Program~'#1'~has~no~#2. }
\msg_new:nnn { pdfcc } { load-only }
  { Option~'#1'~belongs~in~\pdfccload;~ignored~here. }
\msg_new:nnn { pdfcc } { bad-key }
  { Unknown~key~'#1'.~Use~UP,~DOWN,~LEFT,~RIGHT,~SHIFT,~CTRL,~ALT,~ENTER,~ESC,~SPACE,~TAB,~BACKSPACE,~F1~to~F12,~one~character~or~a~number. }
\msg_new:nnn { pdfcc } { rerun }
  { Programs~are~on~other~pages~than~in~the~last~run.~Rerun~to~get~them~loaded~on~the~right~pages. }

\str_new:N \g__pdfcc_engine_str
\sys_if_engine_pdftex:T { \str_gset:Nn \g__pdfcc_engine_str { pdftex } }
\sys_if_engine_luatex:T { \str_gset:Nn \g__pdfcc_engine_str { luatex } }
\sys_if_engine_xetex:T  { \str_gset:Nn \g__pdfcc_engine_str { xetex } }
\str_case:VnF \g__pdfcc_engine_str
  {
    { pdftex } { \int_compare:nNnF { \tex_pdfoutput:D } > 0 { \msg_critical:nn { pdfcc } { engine } } }
    { luatex } { \int_compare:nNnF { \tex_directlua:D { tex.sprint(tex.outputmode) } } > 0 { \msg_critical:nn { pdfcc } { engine } } }
    { xetex } { }
  }
  { \msg_critical:nn { pdfcc } { engine } }
\bool_new:N \g__pdfcc_pdfmanagement_bool
\IfPDFManagementActiveTF { \bool_gset_true:N \g__pdfcc_pdfmanagement_bool } { }
\cs_new:Npn \__pdfcc_engine:n #1 { \str_if_eq_p:Vn \g__pdfcc_engine_str {#1} }

\cs_generate_variant:Nn \msg_error:nnn { nnV , nne }
\cs_generate_variant:Nn \msg_error:nnnn { nnVn }
\prg_generate_conditional_variant:Nnn \regex_match:nn { nV } { F , TF }
\cs_generate_variant:Nn \str_set_convert:Nnnn { NeV , NVV }
\cs_generate_variant:Nn \tl_gput_right:Nn { Ne }

% --------------------------------------------------------------- backend --
% \__pdfcc_annot:nnn {width}{height}{dict}: widget annotation (sizes in bp)
% with its lower left corner at the current point.
\str_case:Vn \g__pdfcc_engine_str
  {
    { pdftex }
      {
        \cs_new_protected:Npn \__pdfcc_annot:nnn #1#2#3
          { \tex_pdfannot:D width ~ #1bp ~ height ~ #2bp ~ depth ~ 0bp ~ {#3} }
        \cs_new_protected:Npn \__pdfcc_catalog:n #1 { \tex_pdfcatalog:D {#1} }
      }
    { luatex }
      {
        \cs_new_protected:Npn \__pdfcc_annot:nnn #1#2#3
          { \tex_pdfextension:D annot ~ width ~ #1bp ~ height ~ #2bp ~ depth ~ 0bp ~ {#3} }
        \cs_new_protected:Npn \__pdfcc_catalog:n #1 { \tex_pdfextension:D catalog {#1} }
      }
    { xetex }
      {
        \cs_new_protected:Npn \__pdfcc_annot:nnn #1#2#3
          { \tex_special:D { pdf:ann ~ width ~ #1bp ~ height ~ #2bp ~ depth ~ 0bp ~ << #3 >> } }
        \cs_new_protected:Npn \__pdfcc_catalog:n #1 { }
      }
  }
\cs_generate_variant:Nn \__pdfcc_annot:nnn { eee }
\cs_generate_variant:Nn \__pdfcc_catalog:n { e }

% Objects (l3pdf). pdfTeX and LuaTeX write them at once; dvipdfmx reads
% specials only from shipped pages, so with XeTeX they wait for the next page.
% (object names are expanded: they contain the instance name)
\cs_new:Npn \__pdfcc_ref:n #1 { \exp_args:Ne \pdf_object_ref:n {#1} }
\cs_new_protected:Npn \__pdfcc_new:n #1 { \exp_args:Ne \pdf_object_new:n {#1} }
\tl_new:N \g__pdfcc_queue_tl
\cs_new_protected:Npn \__pdfcc_write:nnn #1#2#3
  {
    \bool_if:nTF { \__pdfcc_engine:n { xetex } }
      { \tl_gput_right:Ne \g__pdfcc_queue_tl { \exp_not:N \pdf_object_write:nnn {#1} {#2} { \exp_not:n {#3} } } }
      { \exp_args:Ne \pdf_object_write:nnn {#1} {#2} {#3} }
  }
\cs_generate_variant:Nn \__pdfcc_write:nnn { nne }
\cs_new_protected:Npn \__pdfcc_special_later:n #1
  { \tl_gput_right:Nn \g__pdfcc_queue_tl { \tex_special:D {#1} } }
\cs_generate_variant:Nn \__pdfcc_special_later:n { e }
\hook_gput_code:nnn { shipout / background } { pdfcc }
  {
    \tl_if_empty:NF \g__pdfcc_queue_tl
      {
        \tl_use:N \g__pdfcc_queue_tl
        \tl_gclear:N \g__pdfcc_queue_tl
      }
  }

% --------------------------------------------------------------- helpers --
\fp_new:N \l__pdfcc_s_fp      % scale factor of the component being built
\tl_new:N \l__pdfcc_tmp_tl
\tl_new:N \l__pdfcc_tmpa_tl
\tl_new:N \l__pdfcc_tmpb_tl
\str_new:N \l__pdfcc_tmp_str
\cs_new:Npn \__pdfcc_n:n #1 { \fp_eval:n { round ( #1 , 3 ) } }   % number for PDF and TeX
% value in bp: bare numbers are bp, anything else is a TeX dimension
\cs_new_protected:Npn \__pdfcc_bp:nN #1#2
  {
    \tl_set:Ne #2 {#1}
    \regex_match:nVTF { \A\s*[0-9.]+\s*\Z } #2
      { \tl_set:Ne #2 { \fp_eval:n {#2} } }
      { \tl_set:Ne #2 { \dim_to_decimal_in_bp:n {#2} } }
  }
\cs_new_protected:Npn \__pdfcc_put:nnn #1#2#3   % material at (x, y) bp from the lower left
  {
    \hbox_overlap_right:n
      { \skip_horizontal:n { #1 bp } \box_move_up:nn { #2 bp } { \hbox:n {#3} } }
  }
\cs_new_protected:Npn \__pdfcc_size:nn #1#2     % gives the box being built its size
  { \hbox_to_wd:nn { #1 bp } { \tex_vrule:D width ~ 0pt ~ height ~ #2 bp ~ depth ~ 0pt \tex_hfil:D } }
\cs_new_protected:Npn \__pdfcc_rect:nnnnn #1#2#3#4#5  % x y w h color: filled rectangle
  {
    \__pdfcc_put:nnn {#1} {#2}
      {
        \color_group_begin:
          \color_select:n {#5}
          \tex_vrule:D width ~ #3 bp ~ height ~ #4 bp ~ depth ~ 0pt
        \color_group_end:
      }
  }
\cs_generate_variant:Nn \__pdfcc_rect:nnnnn { nnnnV }
\cs_new_protected:Npn \__pdfcc_frame:nnnnnn #1#2#3#4#5#6  % x y w h line color
  {
    \__pdfcc_rect:nnnnn {#1} {#2} {#3} {#5} {#6}
    \__pdfcc_rect:nnnnn {#1} { \__pdfcc_n:n { #2 + #4 - #5 } } {#3} {#5} {#6}
    \__pdfcc_rect:nnnnn {#1} {#2} {#5} {#4} {#6}
    \__pdfcc_rect:nnnnn { \__pdfcc_n:n { #1 + #3 - #5 } } {#2} {#5} {#4} {#6}
  }
% PDF text string from TeX text: hex UTF-16BE with BOM
\str_new:N \g__pdfcc_input_enc_str
\bool_if:nT { \__pdfcc_engine:n { pdftex } } { \str_gset:Nn \g__pdfcc_input_enc_str { utf8 } }
\cs_new_protected:Npn \__pdfcc_hex:nN #1#2
  { \str_set_convert:NeVn #2 { \text_purify:n {#1} } \g__pdfcc_input_enc_str { utf16/hex } }

% ------------------------------------------------------------------ keys --
% One key tree for three levels: \pdfccdeclare (written by pdf2sty.py),
% \pdfccload (an instance) and the placement commands. Values go into
% \l__pdfcc_p_prop under group/key.
\prop_new:N \l__pdfcc_p_prop
\bool_new:N \l__pdfcc_placing_bool
\tl_new:N \l__pdfcc_name_tl     % instance name
\tl_new:N \l__pdfcc_id_tl       % pdfcc_NAME: JavaScript object and field prefix
\tl_new:N \l__pdfcc_prog_tl
\cs_new_protected:Npn \__pdfcc_store:nn #1#2 { \prop_put:Nnn \l__pdfcc_p_prop {#1} {#2} }
\cs_generate_variant:Nn \__pdfcc_store:nn { ne }
\cs_new_protected:Npn \__pdfcc_store_load:nn #1#2
  {
    \bool_if:NTF \l__pdfcc_placing_bool
      { \msg_warning:nnn { pdfcc } { load-only } {#1} }
      { \__pdfcc_store:nn {#1} {#2} }
  }
\cs_generate_variant:Nn \__pdfcc_store_load:nn { nV }
\cs_new_protected:Npn \__pdfcc_group:nn #1#2   % terminal = false | true | {keys}
  {
    \str_case:nnF {#2}
      {
        { false } { \__pdfcc_store:nn {#1} { false } }
        { true }  { \__pdfcc_store:nn {#1} { true } }
      }
      { \__pdfcc_store:nn {#1} { true } \keys_set:nn { pdfcc / #1 } {#2} }
  }
\cs_new_protected:Npn \__pdfcc_def_keys:nnn #1#2#3  % group, keys, keys only for \pdfccload
  {
    \clist_map_inline:nn {#2}
      { \keys_define:nn { pdfcc / #1 } { ##1 .code:n = \__pdfcc_store:nn { #1 / ##1 } {####1} } }
    \clist_map_inline:nn {#3}
      { \keys_define:nn { pdfcc / #1 } { ##1 .code:n = \__pdfcc_store_load:nn { #1 / ##1 } {####1} } }
  }
\__pdfcc_def_keys:nnn { terminal } { fontsize, width, theme, background, color } { cols, rows, echo }
\__pdfcc_def_keys:nnn { display } { scale, width, aspect, frame } { cols, rows, mode, dither, gamma }
\__pdfcc_def_keys:nnn { grid } { } { cols, rows }
\__pdfcc_def_keys:nnn { keyboard } { width, height, fontsize } { placeholder-hex }
\__pdfcc_def_keys:nnn { buttons } { cell, fontsize } { }
\clist_map_inline:nn
  { js, title, subtitle, help, footer, button-list, fit, scale, width, height, fontsize, show, controls, key, id }
  { \keys_define:nn { pdfcc } { #1 .code:n = \__pdfcc_store:nn {#1} {##1} } }
\clist_map_inline:nn { args, pages, load }
  { \keys_define:nn { pdfcc } { #1 .code:n = \__pdfcc_store_load:nn {#1} {##1} } }
\keys_define:nn { pdfcc / keyboard }
  {
    placeholder .code:n =
      {
        \__pdfcc_hex:nN {#1} \l__pdfcc_tmp_str
        \__pdfcc_store_load:nV { keyboard/placeholder-hex } \l__pdfcc_tmp_str
      }
  }
\keys_define:nn { pdfcc }
  {
    terminal .code:n = \__pdfcc_group:nn { terminal } {#1},
    display  .code:n = \__pdfcc_group:nn { display } {#1},
    grid     .code:n = \__pdfcc_group:nn { grid } {#1},
    keyboard .code:n = \__pdfcc_group:nn { keyboard } {#1},
    buttons  .code:n = \__pdfcc_group:nn { buttons } {#1},
    name     .code:n = \bool_if:NTF \l__pdfcc_placing_bool
                         { \msg_warning:nnn { pdfcc } { load-only } { name } }
                         { \tl_set:Ne \l__pdfcc_name_tl {#1} },
    program  .code:n = { },
  }
\keys_define:nn { pdfcc / find }
  {
    program .tl_set:N = \l__pdfcc_prog_tl,
    unknown .code:n = { },
  }
\cs_new:Npn \__pdfcc_get:n #1 { \prop_item:Nn \l__pdfcc_p_prop {#1} }
\prg_new_conditional:Npnn \__pdfcc_if_on:n #1 { p , T , F , TF }
  { \str_if_eq:eeTF { \__pdfcc_get:n {#1} } { true } \prg_return_true: \prg_return_false: }
\prg_new_conditional:Npnn \__pdfcc_if_set:n #1 { p , T , F , TF }
  { \prop_if_in:NnTF \l__pdfcc_p_prop {#1} \prg_return_true: \prg_return_false: }
\prg_new_conditional:Npnn \__pdfcc_if_is:nn #1#2 { p , T , F , TF }
  { \str_if_eq:eeTF { \__pdfcc_get:n {#1} } {#2} \prg_return_true: \prg_return_false: }

% ------------------------------------------------------------ declaration --
\NewDocumentCommand \pdfccdeclare { m m }
  {
    \group_begin:
      \bool_set_false:N \l__pdfcc_placing_bool
      \prop_clear:N \l__pdfcc_p_prop
      \keys_set:nn { pdfcc } {#2}
      \prop_gclear_new:c { g__pdfcc_p_#1_prop }
      \prop_gset_eq:cN { g__pdfcc_p_#1_prop } \l__pdfcc_p_prop
    \group_end:
  }

% ------------------------------------------------------------- instances --
\seq_new:N \g__pdfcc_instances_seq
\tl_new:N \g__pdfcc_last_tl
\seq_new:N \g__pdfcc_fields_seq          % refs of all parent fields
\bool_new:N \g__pdfcc_shared_bool
\bool_new:N \g__pdfcc_hyform_bool        % classic hyperref Form environment seen
\tl_new:N \l__pdfcc_cfg_tl
\str_new:N \l__pdfcc_cfg_str

% In the preamble the PDF backend is not loaded yet: load at \begin{document}.
\bool_new:N \g__pdfcc_document_bool
\hook_gput_code:nnn { begindocument } { pdfcc } { \bool_gset_true:N \g__pdfcc_document_bool }
\NewDocumentCommand \pdfccload { O{} m }
  {
    \bool_if:NTF \g__pdfcc_document_bool
      { \__pdfcc_load_cmd:nn {#1} {#2} }
      { \hook_gput_code:nnn { begindocument } { pdfcc } { \__pdfcc_load_cmd:nn {#1} {#2} } }
  }
\cs_new_protected:Npn \__pdfcc_load_cmd:nn #1#2
  {
    \group_begin:
      \bool_set_false:N \l__pdfcc_placing_bool
      \prop_if_exist:cF { g__pdfcc_p_#2_prop }
        {
          \file_if_exist:nTF { pdfcc-#2.tex }
            { \file_input:n { pdfcc-#2.tex } }
            { \msg_error:nne { pdfcc } { no-file } { pdfcc-#2.tex } }
        }
      \prop_if_exist:cT { g__pdfcc_p_#2_prop } { \__pdfcc_load:nn {#1} {#2} }
    \group_end:
  }

\cs_new_protected:Npn \__pdfcc_load:nn #1#2
  {
    \prop_set_eq:Nc \l__pdfcc_p_prop { g__pdfcc_p_#2_prop }
    \tl_set:Nn \l__pdfcc_name_tl {#2}
    \keys_set:nn { pdfcc } {#1}
    \__pdfcc_store:nn { prog } {#2}
    \regex_match:nVF { \A[a-z0-9]+\Z } \l__pdfcc_name_tl
      { \msg_error:nnV { pdfcc } { bad-name } \l__pdfcc_name_tl }
    \seq_if_in:NVTF \g__pdfcc_instances_seq \l__pdfcc_name_tl
      { \msg_error:nnV { pdfcc } { duplicate } \l__pdfcc_name_tl }
      {
        \tl_set:Ne \l__pdfcc_id_tl { pdfcc_ \l__pdfcc_name_tl }
        \clist_map_inline:nn { terminal, display, keyboard, grid }
          { \__pdfcc_if_set:nF {##1} { \__pdfcc_store:nn {##1} { false } } }
        \exp_args:Ne \tl_if_blank:nTF { \__pdfcc_get:n { button-list } }
          { \__pdfcc_store:nn { buttons } { false } }
          { \__pdfcc_if_set:nF { buttons } { \__pdfcc_store:nn { buttons } { true } } }
        \clist_map_inline:nn { terminal, display, keyboard, buttons, grid }
          { \__pdfcc_store:ne { has/##1 } { \__pdfcc_get:n {##1} } }
        \__pdfcc_shared:
        \pdf_object_if_exist:nF { pdfcc/js/#2 }
          { \__pdfcc_file_object:nn { pdfcc/js/#2 } { \__pdfcc_get:n { js } } }
        \__pdfcc_fields:
        \__pdfcc_chain:
        \prop_gclear_new:c { g__pdfcc_i_ \l__pdfcc_name_tl _prop }
        \prop_gset_eq:cN { g__pdfcc_i_ \l__pdfcc_name_tl _prop } \l__pdfcc_p_prop
        \seq_gput_right:NV \g__pdfcc_instances_seq \l__pdfcc_name_tl
        \tl_gset_eq:NN \g__pdfcc_last_tl \l__pdfcc_name_tl
      }
  }

% Fonts, the runtime and (XeTeX without pdfmanagement) the AcroForm: once.
\cs_new_protected:Npn \__pdfcc_shared:
  {
    \bool_if:NF \g__pdfcc_shared_bool
      {
        \bool_gset_true:N \g__pdfcc_shared_bool
        \clist_map_inline:nn { Helv/Helvetica, Cour/Courier, CoBo/Courier-Bold }
          { \__pdfcc_font:w ##1 \q_stop }
        \__pdfcc_file_object:nn { pdfcc/runtime } { pdfcc-runtime.js }
        \bool_if:NTF \g__pdfcc_pdfmanagement_bool
          {
            \clist_map_inline:nn { Helv, Cour, CoBo }
              {
                \use:e
                  {
                    \exp_not:N \pdfmanagement_add:nnn { Catalog/AcroForm/DR/Font } {##1}
                      { \__pdfcc_ref:n { pdfcc/##1 } }
                  }
              }
          }
          {
            \bool_if:nT { \__pdfcc_engine:n { xetex } }
              {
                \bool_if:NTF \g__pdfcc_hyform_bool
                  { \__pdfcc_xetex_hyperref_dr: }
                  { \__pdfcc_xetex_acroform: }
              }
          }
      }
  }
\cs_new_protected:Npn \__pdfcc_font:w #1/#2 \q_stop
  {
    \__pdfcc_new:n { pdfcc/#1 }
    \__pdfcc_write:nnn { pdfcc/#1 } { dict }
      { /Type/Font/Subtype/Type1/BaseFont/#2/Encoding/WinAnsiEncoding }
  }
\cs_new:Npn \__pdfcc_dr_fonts:
  { /Cour ~ \__pdfcc_ref:n { pdfcc/Cour } ~ /CoBo ~ \__pdfcc_ref:n { pdfcc/CoBo } }
\cs_new_protected:Npn \__pdfcc_file_object:nn #1#2
  {
    \file_get_full_name:nNF {#2} \l__pdfcc_tmp_str
      { \msg_error:nnn { pdfcc } { no-file } {#2} \str_set:Nn \l__pdfcc_tmp_str {#2} }
    \__pdfcc_new:n {#1}
    \__pdfcc_write:nne {#1} { fstream } { { } { \l__pdfcc_tmp_str } }
  }

% Parent fields: one per terminal row, display row and the keyboard.
\cs_new_protected:Npn \__pdfcc_field:nn #1#2  % object name, dict
  {
    \__pdfcc_new:n {#1}
    \__pdfcc_write:nne {#1} { dict } {#2}
    \__pdfcc_add_field:e { \__pdfcc_ref:n {#1} }
  }
\cs_new_protected:Npn \__pdfcc_fields:
  {
    \__pdfcc_if_on:nT { terminal }
      {
        \int_step_inline:nn { \__pdfcc_get:n { terminal/rows } }
          {
            \__pdfcc_field:nn { pdfcc/ \l__pdfcc_name_tl /tty/##1 }
              { /T ( \l__pdfcc_id_tl _tty_ \int_eval:n { ##1 - 1 } ) /FT/Tx/Ff ~ 1 /V () }
          }
      }
    \__pdfcc_if_on:nT { display }
      {
        \int_step_inline:nn { \__pdfcc_get:n { display/rows } }
          {
            \__pdfcc_field:nn { pdfcc/ \l__pdfcc_name_tl /px/##1 }
              {
                /T ( \l__pdfcc_id_tl _px_ \int_eval:n { ##1 - 1 } ) /FT/Tx /V ()
                \__pdfcc_if_is:nnTF { display/mode } { quality }
                  { /Ff ~ 16777217 /MaxLen ~ \__pdfcc_get:n { display/cols } }
                  { /Ff ~ 1 }
              }
          }
      }
    \__pdfcc_if_on:nT { keyboard }
      {
        \__pdfcc_field:nn { pdfcc/ \l__pdfcc_name_tl /kbd }
          {
            /T ( \l__pdfcc_id_tl _kbd ) /FT/Tx/Ff ~ 4096
            /V < \__pdfcc_get:n { keyboard/placeholder-hex } > /DA (/Helv~9~Tf~0.35~g)
            /AA << /K << /S/JavaScript/JS ( \l__pdfcc_id_tl ._key(event) ) >> >>
          }
      }
  }

% /Fields of the AcroForm. pdfmanagement: through it. pdfTeX, LuaTeX: at the
% end (into hyperref's AcroForm if it writes one). XeTeX: our AcroForm on the
% next page, or hyperref's once its Form environment was used.
\cs_new_protected:Npn \__pdfcc_add_field:n #1
  {
    \seq_gput_right:Nn \g__pdfcc_fields_seq {#1}
    \bool_if:NTF \g__pdfcc_pdfmanagement_bool
      { \pdfmanagement_add:nnn { Catalog/AcroForm } { Fields } {#1} }
      {
        \bool_if:nT { \__pdfcc_engine:n { xetex } }
          {
            \bool_if:NTF \g__pdfcc_hyform_bool
              { \tex_special:D { pdf:put ~ @afields ~ #1 } }
              { \__pdfcc_special_later:e { pdf:put ~ \__pdfcc_ref:n { pdfcc/fields } ~ #1 } }
          }
      }
  }
\cs_generate_variant:Nn \__pdfcc_add_field:n { e }
\cs_new_protected:Npn \__pdfcc_xetex_acroform:
  {
    \__pdfcc_new:n { pdfcc/fields }
    \__pdfcc_write:nnn { pdfcc/fields } { array } { }
    \__pdfcc_new:n { pdfcc/aform }
    \__pdfcc_write:nne { pdfcc/aform } { dict }
      {
        /Fields ~ \__pdfcc_ref:n { pdfcc/fields }
        /DR << /Font << /Helv ~ \__pdfcc_ref:n { pdfcc/Helv } ~ \__pdfcc_dr_fonts: >> >>
        /DA (/Helv~0~Tf~0~g)
      }
