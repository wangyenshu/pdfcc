    \bool_if:nT { \__pdfcc_engine:n { luatex } }
      {
        \lua_now:e
          {
            pdfcc.add("\l__pdfcc_name_tl",
              "\lua_escape:e { \tl_use:c { g__pdfcc_full_ \l__pdfcc_name_tl _tl } }",
              "\lua_escape:e { \tl_use:c { g__pdfcc_light_ \l__pdfcc_name_tl _tl } }",
              \__pdfcc_if_is:nnTF { pages } { all } { true } { false },
              \__pdfcc_if_is:nnTF { load } { first } { true } { false })
