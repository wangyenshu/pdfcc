% clist -> JSON strings: "a","b"
\cs_new:Npn \__pdfcc_args:n #1
  { \exp_last_unbraced:Ne \use_none:n { \clist_map_function:nN {#1} \__pdfcc_arg:n } }
\cs_new:Npn \__pdfcc_arg:n #1 { ,"\str_map_function:nN {#1} \__pdfcc_json_char:N " }
