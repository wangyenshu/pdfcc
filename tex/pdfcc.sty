% one button anywhere: \pdfccbutton[key=UP]{label} or \pdfccbutton[id=7]{label}
\tl_new:N \l__pdfcc_code_tl
\tl_new:N \l__pdfcc_isid_tl
\NewDocumentCommand \pdfccbutton { O{} m }
  {
    \group_begin:
      \__pdfcc_place_init:n {#1}
      \bool_if:NT \l__pdfcc_ok_bool
        {
          \fp_set:Nn \l__pdfcc_s_fp { \__pdfcc_if_set:nTF { scale } { \__pdfcc_get:n { scale } } { 1 } }
          \__pdfcc_if_set:nTF { width } { \__pdfcc_bp:nN { \__pdfcc_get:n { width } } \l__pdfcc_tmpa_tl }
            { \tl_set:Nn \l__pdfcc_tmpa_tl { 30 } }
          \__pdfcc_if_set:nTF { height } { \__pdfcc_bp:nN { \__pdfcc_get:n { height } } \l__pdfcc_tmpb_tl }
            { \tl_set:Nn \l__pdfcc_tmpb_tl { 30 } }
          \__pdfcc_if_set:nTF { fontsize } { \__pdfcc_bp:nN { \__pdfcc_get:n { fontsize } } \l__pdfcc_bfs_tl }
            { \tl_set:Nn \l__pdfcc_bfs_tl { 10 } }
          \tl_set:Ne \l__pdfcc_tmpa_tl { \__pdfcc_n:n { \l__pdfcc_tmpa_tl * \l__pdfcc_s_fp } }
          \tl_set:Ne \l__pdfcc_tmpb_tl { \__pdfcc_n:n { \l__pdfcc_tmpb_tl * \l__pdfcc_s_fp } }
          \tl_set:Ne \l__pdfcc_bfs_tl { \__pdfcc_n:n { \l__pdfcc_bfs_tl * \l__pdfcc_s_fp } }
          \__pdfcc_hex:nN {#2} \l__pdfcc_tmp_str
          \__pdfcc_if_set:nTF { id }
            { \tl_set:Ne \l__pdfcc_code_tl { \__pdfcc_get:n { id } } \tl_set:Nn \l__pdfcc_isid_tl { 1 } }
            {
              \__pdfcc_keycode:nN { \__pdfcc_get:n { key } } \l__pdfcc_code_tl
              \tl_set:Nn \l__pdfcc_isid_tl { 0 }
              \int_compare:nNnT { \l__pdfcc_code_tl } < 0
                { \msg_error:nne { pdfcc } { bad-key } { \__pdfcc_get:n { key } } }
            }
          \hbox_set:Nn \l__pdfcc_btn_box
            {
              \__pdfcc_mark:
              \__pdfcc_button:nnnnn { \l__pdfcc_tmpa_tl } { \l__pdfcc_tmpb_tl } { \l__pdfcc_tmp_str }
                { \l__pdfcc_code_tl } { \l__pdfcc_isid_tl }
              \__pdfcc_size:nn { \l__pdfcc_tmpa_tl } { \l__pdfcc_tmpb_tl }
            }
          \mode_leave_vertical: \box_use:N \l__pdfcc_btn_box
        }
    \group_end:
  }
