        \fp_set:Nn \l__pdfcc_fs_fp { ( \l__pdfcc_tmp_tl - 12 ) / ( 0.6 * \__pdfcc_get:n { terminal/cols } ) }
      }
      {
        \__pdfcc_bp:nN { \__pdfcc_get:n { terminal/fontsize } } \l__pdfcc_tmp_tl
        \fp_set:Nn \l__pdfcc_fs_fp { \l__pdfcc_tmp_tl }
