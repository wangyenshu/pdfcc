\cs_new_protected:Npn \__pdfcc_config:
  {
    \tl_set:Ne \l__pdfcc_cfg_tl
      {
        var ~ PDFCC_CONFIG ~ = ~ \c_left_brace_str "name":" \l__pdfcc_id_tl "
        \__pdfcc_if_on:nT { terminal }
          {
            ,"terminal": \c_left_brace_str
              "cols": \__pdfcc_get:n { terminal/cols } ,
              "rows": \__pdfcc_get:n { terminal/rows } ,
              "prefix":" \l__pdfcc_id_tl _tty_"
              \__pdfcc_if_set:nT { terminal/echo } { ,"echo": \__pdfcc_get:n { terminal/echo } }
