% ---- all components, laid out like pdfcc's own page
\bool_new:N \l__pdfcc_t_bool   % terminal
\bool_new:N \l__pdfcc_d_bool   % display
\bool_new:N \l__pdfcc_k_bool   % keyboard
\bool_new:N \l__pdfcc_b_bool   % buttons
\bool_new:N \l__pdfcc_h_bool   % help
\bool_new:N \l__pdfcc_side_bool
\fp_new:N \l__pdfcc_tw_fp
\fp_new:N \l__pdfcc_dw_fp
\fp_new:N \l__pdfcc_cw_fp
\fp_new:N \l__pdfcc_bw_fp
\fp_new:N \l__pdfcc_inner_fp
\clist_new:N \l__pdfcc_show_clist
\cs_new_protected:Npn \__pdfcc_use:nN #1#2
  { \bool_set:Nn #2 { \__pdfcc_if_on_p:n { has/#1 } && ! \__pdfcc_if_is_p:nn {#1} { false } } }
\NewDocumentCommand \pdfccprogram { O{} }
  {
    \group_begin:
      \__pdfcc_place_init:n {#1}
      \bool_if:NT \l__pdfcc_ok_bool { \__pdfcc_program: }
    \group_end:
  }
\cs_new_protected:Npn \__pdfcc_program:
  {
    \__pdfcc_use:nN { terminal } \l__pdfcc_t_bool
    \__pdfcc_use:nN { display } \l__pdfcc_d_bool
    \__pdfcc_use:nN { keyboard } \l__pdfcc_k_bool
    \__pdfcc_use:nN { buttons } \l__pdfcc_b_bool
    \clist_set:Ne \l__pdfcc_show_clist { \__pdfcc_if_set:nTF { show } { \__pdfcc_get:n { show } } { help } }
    \bool_set_false:N \l__pdfcc_h_bool
    \clist_if_in:NnT \l__pdfcc_show_clist { help }
      { \exp_args:Ne \tl_if_blank:nF { \__pdfcc_get:n { help } } { \bool_set_true:N \l__pdfcc_h_bool } }
    % natural sizes
    \fp_zero:N \l__pdfcc_tw_fp \fp_zero:N \l__pdfcc_dw_fp \fp_zero:N \l__pdfcc_bw_fp
    \bool_if:NT \l__pdfcc_t_bool { \__pdfcc_term_measure: \fp_set_eq:NN \l__pdfcc_tw_fp \l__pdfcc_w_fp }
    \bool_if:NT \l__pdfcc_d_bool { \__pdfcc_disp_measure: \fp_set_eq:NN \l__pdfcc_dw_fp \l__pdfcc_w_fp }
    \bool_if:NT \l__pdfcc_b_bool
      { \__pdfcc_cell: \__pdfcc_btn_measure: \fp_set:Nn \l__pdfcc_bw_fp { \l__pdfcc_c_fp * \l__pdfcc_cell_fp } }
    \fp_set:Nn \l__pdfcc_cw_fp
      { \bool_if:NTF \l__pdfcc_k_bool { max ( 190 , \l__pdfcc_bw_fp ) } { \l__pdfcc_bw_fp } }
    \bool_lazy_and:nnT { \fp_compare_p:nNn \l__pdfcc_cw_fp = 0 } { \l__pdfcc_h_bool }
      { \fp_set:Nn \l__pdfcc_cw_fp { 190 } }
    % terminal and controls side by side if that fits
    \__pdfcc_avail:
    \bool_set:Nn \l__pdfcc_side_bool
      {
        \l__pdfcc_t_bool && \fp_compare_p:nNn \l__pdfcc_cw_fp > 0 &&
        (
          \__pdfcc_if_is_p:nn { controls } { right } ||
          (
            ! \__pdfcc_if_is_p:nn { controls } { below } &&
            \fp_compare_p:nNn { \l__pdfcc_tw_fp + 12 + \l__pdfcc_cw_fp } < { \l__pdfcc_avail_fp + 0.01 }
          )
        )
      }
    \fp_set:Nn \l__pdfcc_inner_fp
      {
        max ( \l__pdfcc_dw_fp ,
              \bool_if:NTF \l__pdfcc_side_bool
                { \l__pdfcc_tw_fp + 12 + \l__pdfcc_cw_fp }
                { max ( \l__pdfcc_tw_fp , \l__pdfcc_cw_fp ) } )
      }
    \__pdfcc_scale:n { \l__pdfcc_inner_fp }
    % boxes
    \bool_if:NT \l__pdfcc_t_bool { \__pdfcc_term_box:N \l__pdfcc_term_box }
    \bool_if:NT \l__pdfcc_d_bool { \__pdfcc_disp_box:N \l__pdfcc_disp_box }
    \bool_if:NT \l__pdfcc_b_bool { \__pdfcc_btn_box:N \l__pdfcc_btn_box }
    \bool_if:NT \l__pdfcc_k_bool
      { \__pdfcc_kbd_box:Nn \l__pdfcc_kbd_box { \__pdfcc_n:n { max ( 190 , \l__pdfcc_bw_fp ) } } }
    \tl_set:Ne \l__pdfcc_tmpa_tl { \__pdfcc_n:n { 12 * \l__pdfcc_s_fp } }          % gap
    \tl_set:Ne \l__pdfcc_tmpb_tl { \__pdfcc_n:n { 8 * \l__pdfcc_s_fp } }           % small gap
    \vbox_set_top:Nn \l__pdfcc_ctl_box   % top-aligned: its baseline is its top
      {
        \skip_zero:N \parskip \skip_zero:N \parindent \offinterlineskip
        \skip_vertical:n { 0pt }
        \bool_if:NT \l__pdfcc_k_bool
          { \box_use:N \l__pdfcc_kbd_box \skip_vertical:n { \l__pdfcc_tmpb_tl bp } }
        \bool_if:NT \l__pdfcc_b_bool
          { \box_use:N \l__pdfcc_btn_box \skip_vertical:n { \l__pdfcc_tmpb_tl bp } }
        \bool_if:NT \l__pdfcc_h_bool
          {
            \hbox:n
              {
                \parbox [t] { \__pdfcc_n:n { \l__pdfcc_cw_fp * \l__pdfcc_s_fp } bp }
                  {
                    \raggedright \footnotesize \color_select:n { black!75 }
                    \exp_args:Ne \__pdfcc_lines:n { \__pdfcc_get:n { help } }
                  }
              }
          }
      }
    \mode_leave_vertical:
    \vbox:n
      {
        \skip_zero:N \parskip \skip_zero:N \parindent \offinterlineskip
        \clist_if_in:NnT \l__pdfcc_show_clist { title }
          {
            \hbox:n { \large \bfseries \__pdfcc_get:n { title } \strut }
            \skip_vertical:n { 4pt }
          }
        \clist_if_in:NnT \l__pdfcc_show_clist { subtitle }
          {
            \hbox:n { \small \__pdfcc_get:n { subtitle } \strut }
            \skip_vertical:n { 6pt }
