        \__pdfcc_if_on:nT { display }
          {
            ,"display": \c_left_brace_str
              "cols": \__pdfcc_get:n { display/cols } ,
              "rows": \__pdfcc_get:n { display/rows } ,
              "prefix":" \l__pdfcc_id_tl _px_",
