% LuaLaTeX: the page's action is built while the page is shipped, from the
% placements on it (pdfcc.here). Plain catcodes; no #, ~, % or \ in the Lua.
\ExplSyntaxOff
\ifdefined\directlua
\directlua{
  pdfcc = { order = {}, full = {}, light = {}, all = {}, first = {}, seen = {}, on = {} }
  function pdfcc.add(name, full, light, all, first)
    table.insert(pdfcc.order, name)
    pdfcc.full[name] = full
    pdfcc.light[name] = light
    pdfcc.all[name] = all
    pdfcc.first[name] = first
  end
  function pdfcc.here(name)
    pdfcc.on[name] = true
  end
  function pdfcc.finish()
    local page = tex.count["g_shipout_readonly_int"]
    local parts, closers = {}, 0
    for _, name in ipairs(pdfcc.order) do
      if pdfcc.on[name] or pdfcc.all[name] then
        local s
        if pdfcc.first[name] and not pdfcc.all[name] and pdfcc.seen[name] then
          s = string.gsub(pdfcc.light[name], "PAGE", tostring(pdfcc.seen[name]))
          closers = closers + 3
        else
          s = pdfcc.full[name]
          closers = closers + 4
        end
        if pdfcc.on[name] and not pdfcc.seen[name] then
          pdfcc.seen[name] = page
        end
        table.insert(parts, s)
      end
    end
    pdfcc.on = {}
    if closers == 0 then
      return
    end
    pdfcc.saved = pdf.getpageattributes() or ""
    pdf.setpageattributes(pdfcc.saved .. " /AA << /O " .. table.concat(parts, " /Next ")
      .. string.rep(" >>", closers) .. " >>")
  end
  function pdfcc.restore()
    if pdfcc.saved then
      pdf.setpageattributes(pdfcc.saved)
      pdfcc.saved = nil
    end
  end
}
\fi
\endinput
