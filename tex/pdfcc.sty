      {
        \__pdfcc_bp:nN { \__pdfcc_get:n { display/width } } \l__pdfcc_tmp_tl
        \fp_set:Nn \l__pdfcc_pw_fp { \l__pdfcc_tmp_tl / \__pdfcc_get:n { display/cols } }
      }
      {
        \__pdfcc_bp:nN { \__pdfcc_get:n { display/scale } } \l__pdfcc_tmp_tl
        \fp_set:Nn \l__pdfcc_pw_fp { \l__pdfcc_tmp_tl }
      }
    \fp_set:Nn \l__pdfcc_w_fp { \__pdfcc_get:n { display/cols } * \l__pdfcc_pw_fp }
  }
\cs_new_protected:Npn \__pdfcc_disp_box:N #1
  {
    \__pdfcc_disp_measure:
    \fp_set:Nn \l__pdfcc_pw_fp { \l__pdfcc_pw_fp * \l__pdfcc_s_fp }
    \tl_set:Ne \l__pdfcc_tmpa_tl { \__pdfcc_n:n { \l__pdfcc_pw_fp * \__pdfcc_get:n { display/aspect } } } % row height
    \fp_set:Nn \l__pdfcc_w_fp { \__pdfcc_get:n { display/cols } * \l__pdfcc_pw_fp }
    \fp_set:Nn \l__pdfcc_h_fp { \__pdfcc_get:n { display/rows } * \l__pdfcc_tmpa_tl }
    \fp_set:Nn \l__pdfcc_fs_fp
      { \l__pdfcc_pw_fp / 0.6 * \__pdfcc_if_is:nnTF { display/mode } { quality } { 1.7 } { 0.995 } }
    \hbox_set:Nn #1
      {
        \__pdfcc_mark:
        \__pdfcc_if_is:nnF { display/frame } { false }
          {
            \__pdfcc_frame:nnnnnn { -1 } { -1 } { \__pdfcc_n:n { \l__pdfcc_w_fp + 2 } }
              { \__pdfcc_n:n { \l__pdfcc_h_fp + 2 } } { 0.5 } { black!20 }
          }
        \int_step_inline:nn { \__pdfcc_get:n { display/rows } }
          {
            \__pdfcc_put:nnn { 0 } { \__pdfcc_n:n { \l__pdfcc_h_fp - ##1 * \l__pdfcc_tmpa_tl } }
              {
                \__pdfcc_annot:eee { \__pdfcc_n:n { \l__pdfcc_w_fp } } { \l__pdfcc_tmpa_tl }
                  {
                    /Subtype/Widget/F ~ 4 /BS << /W ~ 0 >>
                    /Parent ~ \__pdfcc_ref:n { pdfcc/ \l__pdfcc_name_tl /px/##1 }
                    /DA (/CoBo ~ \__pdfcc_n:n { \l__pdfcc_fs_fp } ~ Tf ~ 0 ~ g)
                  }
              }
          }
        \bool_lazy_and:nnT { \__pdfcc_if_on_p:n { has/grid } } { ! \__pdfcc_if_is_p:nn { grid } { false } }
          { \__pdfcc_grid: }
        \__pdfcc_size:nn { \__pdfcc_n:n { \l__pdfcc_w_fp } } { \__pdfcc_n:n { \l__pdfcc_h_fp } }
      }
  }
\cs_new_protected:Npn \__pdfcc_grid:   % clickable cells over the display
  {
    \tl_set:Ne \l__pdfcc_tmpa_tl { \__pdfcc_n:n { \l__pdfcc_w_fp / \__pdfcc_get:n { grid/cols } } }
    \tl_set:Ne \l__pdfcc_tmpb_tl { \__pdfcc_n:n { \l__pdfcc_h_fp / \__pdfcc_get:n { grid/rows } } }
    \int_step_inline:nnn { 0 } { \__pdfcc_get:n { grid/rows } - 1 }
      {
        \int_step_inline:nnn { 0 } { \__pdfcc_get:n { grid/cols } - 1 }
          {
            \__pdfcc_put:nnn { \__pdfcc_n:n { ####1 * \l__pdfcc_tmpa_tl } }
              { \__pdfcc_n:n { \l__pdfcc_h_fp - ( ##1 + 1 ) * \l__pdfcc_tmpb_tl } }
              {
                \__pdfcc_annot:eee { \l__pdfcc_tmpa_tl } { \l__pdfcc_tmpb_tl }
                  {
                    /Subtype/Widget/FT/Btn/Ff ~ 65536 /F ~ 4 /BS << /W ~ 0 >> /MK << >>
                    /T ( \l__pdfcc_id_tl _grid_ ####1 _ ##1 )
                    /AA << /D ~ \__pdfcc_js:n { ( \l__pdfcc_id_tl ._gridClick(event,1) ) } >>
                           /U ~ \__pdfcc_js:n { ( \l__pdfcc_id_tl ._gridClick(event,0) ) } >> >>
                  }
              }
          }
      }
  }

% ---- keyboard: a multiline text field; its keystrokes go to the program
\cs_new_protected:Npn \__pdfcc_kbd_measure:n #1   % default width -> tmpa (w), tmpb (h)
  {
    \__pdfcc_if_set:nTF { keyboard/width }
      { \__pdfcc_bp:nN { \__pdfcc_get:n { keyboard/width } } \l__pdfcc_tmpa_tl }
      { \tl_set:Ne \l__pdfcc_tmpa_tl {#1} }
    \__pdfcc_if_set:nTF { keyboard/height }
      { \__pdfcc_bp:nN { \__pdfcc_get:n { keyboard/height } } \l__pdfcc_tmpb_tl }
      { \tl_set:Nn \l__pdfcc_tmpb_tl { 34 } }
  }
\cs_new_protected:Npn \__pdfcc_kbd_box:Nn #1#2   % box, default width (bp)
  {
    \__pdfcc_kbd_measure:n {#2}
    \__pdfcc_if_set:nTF { keyboard/fontsize }
      { \__pdfcc_bp:nN { \__pdfcc_get:n { keyboard/fontsize } } \l__pdfcc_tmp_tl }
      { \tl_set:Nn \l__pdfcc_tmp_tl { 9 } }
    \tl_set:Ne \l__pdfcc_tmpa_tl { \__pdfcc_n:n { \l__pdfcc_tmpa_tl * \l__pdfcc_s_fp } }
    \tl_set:Ne \l__pdfcc_tmpb_tl { \__pdfcc_n:n { \l__pdfcc_tmpb_tl * \l__pdfcc_s_fp } }
    \tl_set:Ne \l__pdfcc_tmp_tl { \__pdfcc_n:n { \l__pdfcc_tmp_tl * \l__pdfcc_s_fp } }
    \hbox_set:Nn #1
      {
        \__pdfcc_mark:
        \__pdfcc_frame:nnnnnn { 0 } { 0 } { \l__pdfcc_tmpa_tl } { \l__pdfcc_tmpb_tl } { 0.75 } { black!40 }
        \__pdfcc_annot:eee { \l__pdfcc_tmpa_tl } { \l__pdfcc_tmpb_tl }
          {
            /Subtype/Widget/F ~ 4 /BS << /W ~ 0 >>
            /Parent ~ \__pdfcc_ref:n { pdfcc/ \l__pdfcc_name_tl /kbd }
            /DA (/Helv ~ \l__pdfcc_tmp_tl \c_space_tl Tf ~ 0.35 ~ g)
            /AA << /Fo ~ \__pdfcc_js:n { ( \l__pdfcc_id_tl ._kbdFocus(true) ) } >>
                   /Bl ~ \__pdfcc_js:n { ( \l__pdfcc_id_tl ._kbdFocus(false) ) } >> >>
          }
        \__pdfcc_size:nn { \l__pdfcc_tmpa_tl } { \l__pdfcc_tmpb_tl }
      }
  }

% ---- buttons. The program's list: {label hex}{code}{is id}{col}{row}{w}{h}...
\int_new:N \g__pdfcc_button_int
\tl_new:N \l__pdfcc_bfs_tl     % button font size
\cs_new_protected:Npn \__pdfcc_button:nnnnn #1#2#3#4#5  % w h label-hex code is-id
  {
    \int_gincr:N \g__pdfcc_button_int
    \__pdfcc_annot:eee {#1} {#2}
      {
        /Subtype/Widget/FT/Btn/Ff ~ 65536 /F ~ 4 /BS << /W ~ 0 >>
        /T ( \l__pdfcc_id_tl _btn_ \int_use:N \g__pdfcc_button_int )
        /DA (/Helv ~ \l__pdfcc_bfs_tl \c_space_tl Tf ~ 0 ~ g)
        /MK << /BG [0.9] /CA <#3> >>
        /AA << /D ~ \__pdfcc_js:n { ( \l__pdfcc_id_tl ._button( #4 ,1 \int_compare:nNnT {#5} = 1 { ,1 } ) ) } >>
               /U ~ \__pdfcc_js:n { ( \l__pdfcc_id_tl ._button( #4 ,0 \int_compare:nNnT {#5} = 1 { ,1 } ) ) } >> >>
      }
  }
\fp_new:N \l__pdfcc_c_fp
\fp_new:N \l__pdfcc_r_fp
\cs_new_protected:Npn \__pdfcc_btn_map:N #1
  {
    \exp_args:NNe \__pdfcc_btn_map_aux:Nw #1
      { \__pdfcc_get:n { button-list } \exp_not:N \q_recursion_tail {} {} {} {} {} {} \exp_not:N \q_recursion_stop }
  }
\cs_new_protected:Npn \__pdfcc_btn_map_aux:Nw #1#2 { \__pdfcc_btn_loop:Nw #1 #2 }
\cs_new_protected:Npn \__pdfcc_btn_loop:Nw #1#2#3#4#5#6#7#8
  {
    \quark_if_recursion_tail_stop:n {#2}
    #1 {#2} {#3} {#4} {#5} {#6} {#7} {#8}
    \__pdfcc_btn_loop:Nw #1
  }
\cs_new_protected:Npn \__pdfcc_btn_measure:   % grid size in cells -> c, r
  {
    \fp_zero:N \l__pdfcc_c_fp
    \fp_zero:N \l__pdfcc_r_fp
    \__pdfcc_btn_map:N \__pdfcc_btn_extent:nnnnnnn
  }
\cs_new_protected:Npn \__pdfcc_btn_extent:nnnnnnn #1#2#3#4#5#6#7
  {
    \fp_set:Nn \l__pdfcc_c_fp { max ( \l__pdfcc_c_fp , #4 + #6 ) }
    \fp_set:Nn \l__pdfcc_r_fp { max ( \l__pdfcc_r_fp , #5 + #7 ) }
  }
\fp_new:N \l__pdfcc_cell_fp
\cs_new_protected:Npn \__pdfcc_cell:
  {
    \__pdfcc_if_set:nTF { buttons/cell }
      { \__pdfcc_bp:nN { \__pdfcc_get:n { buttons/cell } } \l__pdfcc_tmp_tl }
      { \tl_set:Nn \l__pdfcc_tmp_tl { 34 } }
    \fp_set:Nn \l__pdfcc_cell_fp { \l__pdfcc_tmp_tl }
  }
\cs_new_protected:Npn \__pdfcc_btn_box:N #1
  {
    \__pdfcc_cell:
    \fp_set:Nn \l__pdfcc_cell_fp { \l__pdfcc_cell_fp * \l__pdfcc_s_fp }
    \__pdfcc_btn_measure:
    \__pdfcc_if_set:nTF { buttons/fontsize }
      {
        \__pdfcc_bp:nN { \__pdfcc_get:n { buttons/fontsize } } \l__pdfcc_bfs_tl
        \tl_set:Ne \l__pdfcc_bfs_tl { \__pdfcc_n:n { \l__pdfcc_bfs_tl * \l__pdfcc_s_fp } }
      }
      { \tl_set:Ne \l__pdfcc_bfs_tl { \__pdfcc_n:n { 10 * \l__pdfcc_cell_fp / 34 } } }
    \fp_set:Nn \l__pdfcc_w_fp { \l__pdfcc_c_fp * \l__pdfcc_cell_fp }
    \fp_set:Nn \l__pdfcc_h_fp { \l__pdfcc_r_fp * \l__pdfcc_cell_fp }
    \hbox_set:Nn #1
      {
        \__pdfcc_mark:
        \__pdfcc_btn_map:N \__pdfcc_btn_place:nnnnnnn
        \__pdfcc_size:nn { \__pdfcc_n:n { \l__pdfcc_w_fp } } { \__pdfcc_n:n { \l__pdfcc_h_fp - 4 * \l__pdfcc_s_fp } }
      }
  }
\cs_new_protected:Npn \__pdfcc_btn_place:nnnnnnn #1#2#3#4#5#6#7  % label code is-id col row w h
  {
    \__pdfcc_put:nnn { \__pdfcc_n:n { #4 * \l__pdfcc_cell_fp } }
      { \__pdfcc_n:n { \l__pdfcc_h_fp - ( #5 + #7 ) * \l__pdfcc_cell_fp } }
      {
        \__pdfcc_button:nnnnn { \__pdfcc_n:n { #6 * \l__pdfcc_cell_fp - 4 * \l__pdfcc_s_fp } }
          { \__pdfcc_n:n { #7 * \l__pdfcc_cell_fp - 4 * \l__pdfcc_s_fp } } {#1} {#2} {#3}
      }
  }
% key name -> code in #2 (the codes of tools/mkpdf.py and runtime/pdfcc.h); -1 if unknown
\cs_new_protected:Npn \__pdfcc_keycode:nN #1#2
  {
    \tl_set:Ne #2 {#1}
    \tl_set:Ne #2
      {
        \str_case_e:nnF { #2 }
          {
            { UP } { 256 } { DOWN } { 257 } { LEFT } { 258 } { RIGHT } { 259 }
            { SHIFT } { 260 } { CTRL } { 261 } { ALT } { 262 } { ENTER } { 13 } { RETURN } { 13 }
            { ESC } { 27 } { ESCAPE } { 27 } { SPACE } { 32 } { TAB } { 9 } { BACKSPACE } { 8 }
            { F1 } { 272 } { F2 } { 273 } { F3 } { 274 } { F4 } { 275 } { F5 } { 276 } { F6 } { 277 }
            { F7 } { 278 } { F8 } { 279 } { F9 } { 280 } { F10 } { 281 } { F11 } { 282 } { F12 } { 283 }
          }
          { \exp_not:V #2 }
      }
    \regex_match:nVF { \A[0-9]+\Z } #2
      {
        \int_compare:nNnTF { \str_count:V #2 } = 1
          { \tl_set:Ne #2 { \int_eval:n { \exp_after:wN ` #2 } } }
          { \tl_set:Nn #2 { -1 } }
      }
  }

\cs_new_protected:Npn \__pdfcc_lines:n #1
  { \tl_map_inline:nn {#1} { \mode_leave_vertical: ##1 \par } }

