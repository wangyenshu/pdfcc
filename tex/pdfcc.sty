        \bool_if:NT \l__pdfcc_d_bool
          {
            \hbox_to_wd:nn { \__pdfcc_n:n { \l__pdfcc_inner_fp * \l__pdfcc_s_fp } bp }
              { \tex_hss:D \box_use:N \l__pdfcc_disp_box \tex_hss:D }
            \bool_lazy_or:nnT { \l__pdfcc_t_bool } { \fp_compare_p:nNn \l__pdfcc_cw_fp > 0 }
              { \skip_vertical:n { \l__pdfcc_tmpa_tl bp } }
