    \tl_gset:ce { g__pdfcc_light_ \l__pdfcc_name_tl _tl }
      {
        \__pdfcc_js:n { < \l__pdfcc_cfg_str > } /Next
        \__pdfcc_js:n { \__pdfcc_ref:n { pdfcc/runtime } } /Next
        \__pdfcc_js:n { ( \l__pdfcc_id_tl .start(PAGE) ) }
