% Page-open sequence of an instance: config, runtime, program, start. "full"
% loads the program; "light" (load=first, later pages) only starts it.
\cs_new:Npn \__pdfcc_js:n #1 { << /S/JavaScript/JS ~ #1 }
\cs_new_protected:Npn \__pdfcc_chain:
  {
    \__pdfcc_config:
    \tl_gclear_new:c { g__pdfcc_full_ \l__pdfcc_name_tl _tl }
    \tl_gset:ce { g__pdfcc_full_ \l__pdfcc_name_tl _tl }
      {
        \__pdfcc_js:n { < \l__pdfcc_cfg_str > } /Next
        \__pdfcc_js:n { \__pdfcc_ref:n { pdfcc/runtime } } /Next
        \__pdfcc_js:n { \__pdfcc_ref:n { pdfcc/js/ \__pdfcc_get:n { prog } } } /Next
        \__pdfcc_js:n { ( \l__pdfcc_id_tl .start() ) }
      }
