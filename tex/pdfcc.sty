        {
          \__pdfcc_alias:nn { fontsize } { buttons }
          \__pdfcc_cell:
          \__pdfcc_btn_measure:
          \__pdfcc_scale:n { \l__pdfcc_c_fp * \l__pdfcc_cell_fp }
          \__pdfcc_btn_box:N \l__pdfcc_btn_box
          \mode_leave_vertical: \box_use:N \l__pdfcc_btn_box
        }
