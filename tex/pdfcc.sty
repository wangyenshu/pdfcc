% ------------------------------------------------------- page-open actions --
% Shipped placements are recorded as \pdfcc@page{name}{page} in the .aux
% (pdfLaTeX, XeLaTeX) or in Lua (LuaLaTeX).
\prop_new:N \g__pdfcc_prev_prop     % name/page from the last run
\prop_new:N \g__pdfcc_now_prop      % this run (the .aux read again at the end)
\bool_new:N \g__pdfcc_aux_end_bool
\cs_new_protected:cpn { pdfcc@page } #1#2
  {
    \bool_if:NTF \g__pdfcc_aux_end_bool
      { \prop_gput:Nnn \g__pdfcc_now_prop { #1/#2 } { } }
      {
        \prop_gput:Nnn \g__pdfcc_prev_prop { #1/#2 } { }
        \seq_if_exist:cF { g__pdfcc_page_#2_seq } { \seq_new:c { g__pdfcc_page_#2_seq } }
        \seq_if_in:cnF { g__pdfcc_page_#2_seq } {#1} { \seq_gput_right:cn { g__pdfcc_page_#2_seq } {#1} }
        \int_if_exist:cF { g__pdfcc_first_#1_int }
          { \int_new:c { g__pdfcc_first_#1_int } \int_gset:cn { g__pdfcc_first_#1_int } {#2} }
      }
  }
\hook_gput_code:nnn { begindocument } { pdfcc }
  { \legacy_if:nT { @filesw } { \iow_now:Nn \@auxout { \providecommand \pdfcc@page [2] { } } } }
\hook_gput_code:nnn { enddocument / afterlastpage } { pdfcc }
  { \bool_gset_true:N \g__pdfcc_aux_end_bool }
\bool_new:N \l__pdfcc_changed_bool
\hook_gput_code:nnn { enddocument / afteraux } { pdfcc } { \__pdfcc_check_pages: }
\cs_new_protected:Npn \__pdfcc_check_pages:
  {
    \bool_lazy_and:nnT { ! \__pdfcc_engine:n { luatex } } { \legacy_if_p:n { @filesw } }
      {
        \bool_set_false:N \l__pdfcc_changed_bool
        \prop_map_inline:Nn \g__pdfcc_now_prop
          { \prop_if_in:NnF \g__pdfcc_prev_prop {##1} { \bool_set_true:N \l__pdfcc_changed_bool } }
        \prop_map_inline:Nn \g__pdfcc_prev_prop
          { \prop_if_in:NnF \g__pdfcc_now_prop {##1} { \bool_set_true:N \l__pdfcc_changed_bool } }
        \bool_if:NT \l__pdfcc_changed_bool { \msg_warning:nn { pdfcc } { rerun } }
      }
  }

% marker in a placement: travels with the box, acts when shipped
\cs_new_protected:Npn \__pdfcc_mark:
  {
    \bool_if:nTF { \__pdfcc_engine:n { luatex } }
      { \use:e { \tex_latelua:D { pdfcc.here("\l__pdfcc_name_tl") } } }
      {
        \legacy_if:nT { @filesw }
          {
            \exp_args:NNe \iow_shipout_x:Nn \@auxout
              {
                \token_to_str:N \pdfcc@page { \l__pdfcc_name_tl }
                  { \exp_not:N \int_use:N \exp_not:N \g_shipout_readonly_int }
              }
          }
      }
  }

% pdfLaTeX, XeLaTeX: the action for page #1 from the last run's records
\tl_new:N \l__pdfcc_chain_tl
\int_new:N \l__pdfcc_closers_int
\bool_new:N \l__pdfcc_here_bool
\tl_new:N \g__pdfcc_saved_attr_tl
\bool_new:N \g__pdfcc_attr_set_bool
\cs_new_protected:Npn \__pdfcc_page_chain:n #1
  {
    \tl_clear:N \l__pdfcc_chain_tl
    \int_zero:N \l__pdfcc_closers_int
    \seq_map_inline:Nn \g__pdfcc_instances_seq
      {
        \prop_set_eq:Nc \l__pdfcc_p_prop { g__pdfcc_i_##1_prop }
        \bool_set:Nn \l__pdfcc_here_bool
          { \__pdfcc_if_is_p:nn { pages } { all } || ! \int_if_exist_p:c { g__pdfcc_first_##1_int } }
        \seq_if_exist:cT { g__pdfcc_page_#1_seq }
          { \seq_if_in:cnT { g__pdfcc_page_#1_seq } {##1} { \bool_set_true:N \l__pdfcc_here_bool } }
        \bool_if:NT \l__pdfcc_here_bool
          {
            \tl_if_empty:NF \l__pdfcc_chain_tl { \tl_put_right:Nn \l__pdfcc_chain_tl { ~ /Next ~ } }
            \bool_lazy_all:nTF
              {
                { \__pdfcc_if_is_p:nn { load } { first } }
                { ! \__pdfcc_if_is_p:nn { pages } { all } }
                { \int_if_exist_p:c { g__pdfcc_first_##1_int } }
                { ! \int_compare_p:nNn { \int_use:c { g__pdfcc_first_##1_int } } = {#1} }
              }
              {
                \tl_set_eq:Nc \l__pdfcc_tmp_tl { g__pdfcc_light_##1_tl }
                \tl_replace_once:Nne \l__pdfcc_tmp_tl { PAGE } { \int_use:c { g__pdfcc_first_##1_int } }
                \tl_put_right:NV \l__pdfcc_chain_tl \l__pdfcc_tmp_tl
                \int_add:Nn \l__pdfcc_closers_int { 3 }
              }
              {
                \tl_put_right:Nv \l__pdfcc_chain_tl { g__pdfcc_full_##1_tl }
                \int_add:Nn \l__pdfcc_closers_int { 4 }
              }
          }
      }
    \tl_put_right:Ne \l__pdfcc_chain_tl { \prg_replicate:nn { \l__pdfcc_closers_int } { ~ >> } }
  }
\cs_generate_variant:Nn \tl_replace_once:Nnn { Nne }

\str_case:Vn \g__pdfcc_engine_str
  {
    { pdftex }
      {
        % with pdfmanagement: through its Page dictionary, which it turns into
        % \pdfpageattr after the background hook
        \hook_gput_code:nnn { shipout / background } { pdfcc }
          {
            \bool_lazy_and:nnT { \g__pdfcc_pdfmanagement_bool } { ! \seq_if_empty_p:N \g__pdfcc_instances_seq }
              {
                \__pdfcc_page_chain:n { \int_use:N \g_shipout_readonly_int }
                \int_compare:nNnT \l__pdfcc_closers_int > 0
                  {
                    \use:e { \exp_not:N \pdfmanagement_add:nnn { Page } { AA } { << /O ~ \l__pdfcc_chain_tl >> } }
                    \bool_gset_true:N \g__pdfcc_attr_set_bool
                  }
              }
          }
        \hook_gput_code:nnn { shipout / foreground } { pdfcc }
          {
            \bool_lazy_and:nnT { ! \g__pdfcc_pdfmanagement_bool } { ! \seq_if_empty_p:N \g__pdfcc_instances_seq }
              {
                \__pdfcc_page_chain:n { \int_use:N \g_shipout_readonly_int }
                \int_compare:nNnT \l__pdfcc_closers_int > 0
                  {
                    \tl_gset:No \g__pdfcc_saved_attr_tl { \tex_the:D \tex_pdfpageattr:D }
                    \bool_gset_true:N \g__pdfcc_attr_set_bool
                    \tl_set:Ne \l__pdfcc_tmp_tl
                      { \tex_the:D \tex_pdfpageattr:D \c_space_tl /AA << /O ~ \l__pdfcc_chain_tl >> }
                    \tex_global:D \tex_pdfpageattr:D \exp_after:wN { \l__pdfcc_tmp_tl }
                  }
              }
          }
        \hook_gput_code:nnn { shipout / after } { pdfcc }
          {
            \bool_if:NT \g__pdfcc_attr_set_bool
              {
                \bool_gset_false:N \g__pdfcc_attr_set_bool
                \bool_if:NTF \g__pdfcc_pdfmanagement_bool
                  { \pdfmanagement_remove:nn { Page } { AA } }
                  { \tex_global:D \tex_pdfpageattr:D \exp_after:wN { \g__pdfcc_saved_attr_tl } }
              }
          }
      }
    { xetex }
      {
        \hook_gput_code:nnn { shipout / foreground } { pdfcc }
          {
            \seq_if_empty:NF \g__pdfcc_instances_seq
              {
                \__pdfcc_page_chain:n { \int_use:N \g_shipout_readonly_int }
                \int_compare:nNnT \l__pdfcc_closers_int > 0
                  { \tex_special:D { pdf:put ~ @thispage ~ << /AA << /O ~ \l__pdfcc_chain_tl >> >> } }
              }
          }
      }
    { luatex }
      {
        \hook_gput_code:nnn { shipout / foreground } { pdfcc }
          { \seq_if_empty:NF \g__pdfcc_instances_seq { \tex_latelua:D { pdfcc.finish() } } }
        \hook_gput_code:nnn { shipout / after } { pdfcc }
          { \lua_now:n { pdfcc.restore() } }
      }
  }

