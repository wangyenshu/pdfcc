\cs_new_protected:Npn \__pdfcc_term_box:N #1   % at scale \l__pdfcc_s_fp
  {
    \__pdfcc_term_measure:
    \fp_set:Nn \l__pdfcc_fs_fp { \l__pdfcc_fs_fp * \l__pdfcc_s_fp }
    \tl_set:Ne \l__pdfcc_tmpa_tl { \__pdfcc_n:n { \l__pdfcc_fs_fp * 1.2 } }      % line height
    \tl_set:Ne \l__pdfcc_tmpb_tl { \__pdfcc_n:n { 4 * \l__pdfcc_s_fp } }         % padding
    \fp_set:Nn \l__pdfcc_w_fp { \__pdfcc_get:n { terminal/cols } * 0.6 * \l__pdfcc_fs_fp + 3 * \l__pdfcc_tmpb_tl }
    \fp_set:Nn \l__pdfcc_h_fp { \__pdfcc_get:n { terminal/rows } * \l__pdfcc_tmpa_tl + 2 * \l__pdfcc_tmpb_tl }
    \__pdfcc_if_is:nnTF { terminal/theme } { dark }
      { \tl_set:Nn \l__pdfcc_bg_tl { black!92 } \tl_set:Nn \l__pdfcc_fg_tl { green!45!white } }
      { \tl_set:Nn \l__pdfcc_bg_tl { black!4 } \tl_set:Nn \l__pdfcc_fg_tl { black!90 } }
    \__pdfcc_if_set:nT { terminal/background } { \tl_set:Ne \l__pdfcc_bg_tl { \__pdfcc_get:n { terminal/background } } }
    \__pdfcc_if_set:nT { terminal/color } { \tl_set:Ne \l__pdfcc_fg_tl { \__pdfcc_get:n { terminal/color } } }
    \exp_args:NV \color_export:nnN \l__pdfcc_fg_tl { space-sep-rgb } \l__pdfcc_fg_tl
    \hbox_set:Nn #1
      {
        \__pdfcc_mark:
        \__pdfcc_rect:nnnnV { 0 } { 0 } { \__pdfcc_n:n { \l__pdfcc_w_fp } } { \__pdfcc_n:n { \l__pdfcc_h_fp } }
          \l__pdfcc_bg_tl
        \int_step_inline:nn { \__pdfcc_get:n { terminal/rows } }
          {
            \__pdfcc_put:nnn { \l__pdfcc_tmpb_tl }
              { \__pdfcc_n:n { \l__pdfcc_h_fp - \l__pdfcc_tmpb_tl - ##1 * \l__pdfcc_tmpa_tl } }
              {
                \__pdfcc_annot:eee { \__pdfcc_n:n { \l__pdfcc_w_fp - 2 * \l__pdfcc_tmpb_tl } } { \l__pdfcc_tmpa_tl }
