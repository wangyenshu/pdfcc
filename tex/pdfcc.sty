% ---- terminal: rows x cols text fields, Courier
\fp_new:N \l__pdfcc_fs_fp
\fp_new:N \l__pdfcc_w_fp
\fp_new:N \l__pdfcc_h_fp
\tl_new:N \l__pdfcc_bg_tl
\tl_new:N \l__pdfcc_fg_tl
\box_new:N \l__pdfcc_term_box
\box_new:N \l__pdfcc_disp_box
